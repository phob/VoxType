{
  "name": "voxtype",
  "version": "0.3.9",
  "description": "Windows-first local speech-to-text app.",
  "private": true,
  "author": "VoxType",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "oxlint electron.vite.config.ts src --max-warnings=0",
    "build": "bun run typecheck && electron-vite build",
    "build:native:release": "cargo build --manifest-path native/windows-helper/Cargo.toml --release",
    "e2e:native-recording": "node scripts/e2e-native-recording.mjs",
    "e2e:dictation": "bun scripts/e2e-dictation/run.ts",
    "e2e:cleanup": "bun scripts/e2e-cleanup/run.ts",
    "e2e:cleanup-app": "bun run build && bun scripts/e2e-cleanup/app-smoke.ts",
    "e2e:cleanup-prompt": "bun run build && bun scripts/e2e-cleanup/custom-prompt.ts",
    "e2e:hotkeys": "bun run build && bun scripts/e2e-hotkeys/run.ts",
    "e2e:game-suspension": "bun run build && bun scripts/e2e-game-suspension/run.ts",
    "e2e:focus": "bun run build && bun scripts/e2e-focus/run.ts",
    "dist:win": "bun run verify:packaging && bun run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "release:win": "bun run build:native:release && bun run dist:win",
    "release:version": "node scripts/sync-release-version.mjs",
    "changelog": "node scripts/generate-release-notes.mjs",
    "changelog:detailed": "node scripts/generate-detailed-release-notes.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify:packaging": "node scripts/verify-packaging-config.mjs"
  },
  "build": {
    "appId": "com.voxtype.app",
    "productName": "VoxType",
    "executableName": "VoxType",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/models/silero_vad_v4.onnx",
        "to": "models/silero_vad_v4.onnx"
      },
      {
        "from": "native/windows-helper/target/release/voxtype-windows-helper.exe",
        "to": "native/voxtype-windows-helper.exe"
      }
    ],
    "win": {
      "icon": "resources/icons/voxtype.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoxType"
    },
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "lucide-react": "^1.11.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@swc/core": "^1.15.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "latest",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "latest",
    "vite": "^8.0.0"
  }
}
